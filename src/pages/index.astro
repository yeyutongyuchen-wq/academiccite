---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="AcademicCite – Citation Cross-Reference & Research Trend Visualizer">
  <div class="min-h-[70vh] flex flex-col items-center justify-center px-4 text-center">
    <h1 class="text-4xl sm:text-5xl font-bold text-academic-slate-900 tracking-tight">
      AcademicCite
    </h1>
    <p class="mt-4 text-lg text-academic-slate-600 max-w-xl">
      High-performance academic citation cross-reference powered by OpenAlex & Unpaywall.
      Zero-key, edge-cached, globally scalable.
    </p>
    <p class="mt-8 text-sm text-academic-slate-500">
      Example: <a href="/paper/10.1038/nature14539" class="text-academic-indigo-600 hover:underline font-medium">/paper/10.1038/nature14539</a>
    </p>
  </div>
</BaseLayout>