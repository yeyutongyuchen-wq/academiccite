---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PaperSidebar from '../../components/PaperSidebar.astro';
import { reconstructAbstract, extractTakeaways } from '../../utils/abstract.js';
import { formatAPA, formatIEEE, formatMLA } from '../../utils/citations.js';
import { normalizeDoi, buildApiUrls } from '../../utils/paper.js';

const rawDoi = Astro.params.doi;
const doi = normalizeDoi(rawDoi);

if (!doi) {
  return new Response('Invalid DOI', { status: 400 });
}

const cacheKey = `paper:v1:${doi}`;
let paperData = null;
let fromCache = false;

// 安全获取 KV（防止绑定未生效时崩溃）
const runtime = Astro.locals?.runtime;
const KV = runtime?.env?.ACADEMIC_CACHE ?? null;

try {
  // 1. 尝试读取缓存
  if (KV) {
    try {
      const cached = await KV.get(cacheKey, { type: 'json' });
      if (cached && cached.work) {
        paperData = cached;
        fromCache = true;
      }
    } catch (e) {
      console.error('KV read failed:', e);
    }
  }

  // 2. 缓存未命中时请求 API
  if (!paperData) {
    const { openAlex, unpaywall } = buildApiUrls(doi);

    const [oaRes, upRes] = await Promise.all([
      fetch(openAlex, {
        headers: {
          'User-Agent': 'AcademicCite/1.0 (mailto:您的真实邮箱@gmail.com)',
          'Accept': 'application/json'
        }
      }),
      fetch(unpaywall, {
        headers: {
          'Accept': 'application/json'
        }
      })
    ]);

    if (oaRes.status === 404) {
      return new Response('Paper not found', { status: 404 });
    }

    if (oaRes.status === 429) {
      return new Response(
        'OpenAlex is rate limiting requests. Please wait a few minutes and try again.',
        { status: 429, headers: { 'Content-Type': 'text/plain; charset=utf-8' } }
      );
    }

    if (!oaRes.ok) {
      return new Response(`OpenAlex error: ${oaRes.status}`, { status: 502 });
    }

    const work = await oaRes.json();
    let unpaywallData = null;

    if (upRes.ok) {
      try {
        unpaywallData = await upRes.json();
      } catch (_) {}
    }

    const abstract = reconstructAbstract(work.abstract_inverted_index);

    paperData = {
      work: {
        id: work.id,
        doi: work.doi,
        title: work.title,
        publication_year: work.publication_year,
        cited_by_count: work.cited_by_count || 0,
        authorships: (work.authorships || []).map(a => ({
          author: { display_name: a.author?.display_name || '' }
        })),
        primary_location: work.primary_location ? {
          source: { display_name: work.primary_location.source?.display_name || '' },
          landing_page_url: work.primary_location.landing_page_url || null
        } : null,
        biblio: work.biblio || {}
      },
      abstract,
      unpaywall: unpaywallData ? {
        is_oa: !!unpaywallData.is_oa,
        best_oa_location: unpaywallData.best_oa_location ? {
          url_for_pdf: unpaywallData.best_oa_location.url_for_pdf || null
        } : null,
        doi_url: unpaywallData.doi_url || null
      } : null,
      cached_at: new Date().toISOString()
    };

    // 写入缓存（失败不影响主流程）
    if (KV) {
      try {
        await KV.put(cacheKey, JSON.stringify(paperData), {
          expirationTtl: 2592000
        });
      } catch (e) {
        console.error('KV write failed:', e);
      }
    }
  }
} catch (err) {
  console.error('Unexpected error in paper page:', err);
  return new Response('An unexpected error occurred while loading this paper. Please try again later.', {
    status: 500,
    headers: { 'Content-Type': 'text/plain; charset=utf-8' }
  });
}

// 后续渲染逻辑保持不变……
const work = paperData.work;
// ... 其余代码继续
