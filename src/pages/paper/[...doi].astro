---
// src/pages/paper/[...doi].astro
export const prerender = false; // 严格开启服务端动态渲染模式

const { doi } = Astro.params;

if (!doi) {
  return new Response("Missing DOI", { status: 400 });
}

let title = "Untitled Research Paper";
let year = new Date().getFullYear();
let citations = 0;
let journal = "Academic Journal";
let authorsArray = [];
let abstractText = "No abstract available for this work.";
let isOpenAccess = false;
let pdfUrl = "";

try {
  // 核心：直接请求你已经完美跑通的硅谷服务器 secure API 接口
  const proxyUrl = `https://academiccite.com{encodeURIComponent(doi)}`;
  const response = await fetch(proxyUrl);

  if (response.status === 404) {
    return new Response("Paper Not Found in Academic Index", { status: 404 });
  }

  if (response.ok) {
    const data = await response.json();
    title = data.title || title;
    year = data.publication_year || year;
    citations = data.cited_by_count || 0;
    journal = data.primary_location?.source_name || journal;
    authorsArray = data.authorships?.map(a => a.display_name) || [];
    abstractText = data.abstract || abstractText;
    isOpenAccess = data.is_oa || false;
    pdfUrl = data.pdf_url || "";
  }
} catch (error) {
  return new Response(`Edge Gateway Connection Error: ${error.message}`, { status: 502 });
}

// 格式化 APA、IEEE、MLA 三大格式（内置空值与多作者优雅容错）
const firstAuthor = authorsArray[0] || "Unknown Author";
const authorCount = authorsArray.length;

let apaAuthors = firstAuthor;
if (authorCount > 1 && authorCount <= 20) {
  apaAuthors = authorsArray.slice(0, -1).join(", ") + ", & " + authorsArray[authorCount - 1];
} else if (authorCount > 20) {
  apaAuthors = authorsArray.slice(0, 19).join(", ") + ", ... " + authorsArray[authorCount - 1];
}
const apaCitation = `${apaAuthors}. (${year}). ${title}. ${journal}.`;
const ieeeAuthors = authorCount > 3 ? `${firstAuthor} et al.` : authorsArray.join(", ");
const ieeeCitation = `${ieeeAuthors}, "${title}," ${journal}, ${year}.`;
const mlaAuthors = authorCount > 2 ? `${firstAuthor}, et al.` : authorsArray.join(" and ");
const mlaCitation = `${mlaAuthors}. "${title}." ${journal}, ${year}.`;

const currentYear = new Date().getFullYear();
const shouldNoindex = (currentYear - year >= 3 && citations === 0);
const robotsMeta = shouldNoindex ? "noindex, follow" : "index, follow";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} ({year}) - Citation | AcademicCite</title>
  <meta name="robots" content={robotsMeta} />
  <script src="https://jsdelivr.net"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col font-sans antialiased">

  <!-- 顶部导航 -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-50 px-6 py-4 shadow-sm flex justify-between items-center">
    <div class="flex items-center gap-2">
      <a href="/" class="text-xl font-bold text-indigo-600 tracking-tight">AcademicCite.com</a>
      <span class="bg-indigo-50 text-indigo-700 text-xs px-2 py-0.5 rounded border border-indigo-100 font-medium">Edge SSR</span>
    </div>
  </header>

  <!-- 双栏学术风布局 -->
  <main class="max-w-6xl w-full mx-auto px-6 py-8 grid grid-cols-1 lg:grid-cols-3 gap-8 flex-1">
    <!-- 左侧 70%：核心数据层 -->
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs">
        <div class="flex items-center gap-3 mb-4">
          <span class="bg-slate-100 text-slate-600 text-xs px-2.5 py-1 rounded-md font-mono font-medium">{year}</span>
          {isOpenAccess ? 
            <span class="bg-emerald-50 text-emerald-700 text-xs px-2.5 py-1 rounded-md font-semibold border border-emerald-100">🟢 Open Access</span> : 
            <span class="bg-slate-100 text-slate-500 text-xs px-2.5 py-1 rounded-md font-medium border border-slate-200">🔒 Closed Access</span>
          }
        </div>
        <h1 class="text-2xl md:text-3xl font-bold text-slate-900 leading-tight mb-4">{title}</h1>
        <p class="text-sm text-slate-600 mb-2"><strong class="text-slate-800">Authors:</strong> {authorsArray.join(', ')}</p>
        <p class="text-sm text-slate-600 mb-4"><strong class="text-slate-800">Journal:</strong> <span class="italic text-indigo-600">{journal}</span></p>
        <p class="text-xs text-slate-400 font-mono">DOI: {doi}</p>
      </div>

      <!-- AI 智能摘要区 -->
      <div class="bg-gradient-to-br from-indigo-50/40 to-slate-50 p-6 rounded-2xl border border-indigo-100 shadow-xs">
        <h3 class="text-sm font-bold text-indigo-900 tracking-wider uppercase mb-3">✨ AI Key Insights (3-Bullet Breakdown)</h3>
        <ul class="space-y-2.5 text-sm text-slate-700">
          <li>🔹 <span class="font-medium text-slate-900">Category Impact:</span> Indexed inside the <span class="italic text-indigo-600">{journal}</span> network.</li>
          <li>🔹 <span class="font-medium text-slate-900">Citation Weight:</span> Verified by <span class="text-indigo-600 font-semibold font-mono">{citations}</span> independent academic citations.</li>
          <li>🔹 <span class="font-medium text-slate-900">Contextual Snippet:</span> {abstractText.substring(0, 120)}...</li>
        </ul>
      </div>

      <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs">
        <h2 class="text-lg font-bold text-slate-900 mb-3">Original Abstract</h2>
        <p class="text-sm text-slate-600 leading-relaxed font-serif text-justify">{abstractText}</p>
      </div>
    </div>

    <!-- 右侧 30%：快捷面板与变现导流 -->
    <div class="lg:col-span-1 space-y-6">
      <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs space-y-4">
        <h3 class="text-sm font-bold text-slate-800 tracking-wide uppercase">Document Actions</h3>
        
        {isOpenAccess && pdfUrl ? 
          <a href={pdfUrl} target="_blank" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-3 px-4 rounded-xl transition flex justify-center items-center gap-2 text-sm shadow-sm">📄 Read Free Legal PDF</a> : 
          <a href={`https://doi.org{doi}`} target="_blank" class="w-full bg-slate-800 hover:bg-slate-900 text-white font-medium py-3 px-4 rounded-xl transition flex justify-center items-center gap-2 text-sm shadow-sm">🌐 View on Publisher Site</a>
        }

        <!-- 3大引文快捷复制框 -->
        <div class="border-t border-slate-100 pt-4 space-y-3">
          <label class="block text-xs font-semibold text-slate-500 uppercase">Generated Citations</label>
          <div class="space-y-2">
            <div class="bg-slate-900 text-slate-200 p-3 rounded-lg font-mono text-xs break-all" id="apaBox">
              <span class="text-[10px] text-indigo-400 font-bold uppercase block mb-1">[APA 7th]</span>{apaCitation}
            </div>
            <div class="bg-slate-900 text-slate-200 p-3 rounded-lg font-mono text-xs break-all" id="ieeeBox">
              <span class="text-[10px] text-amber-400 font-bold uppercase block mb-1">[IEEE]</span>{ieeeCitation}
            </div>
            <div class="bg-slate-900 text-slate-200 p-3 rounded-lg font-mono text-xs break-all" id="mlaBox">
              <span class="text-[10px] text-pink-400 font-bold uppercase block mb-1">[MLA]</span>{mlaCitation}
            </div>
          </div>
          <button onclick="navigator.clipboard.writeText(document.getElementById('apaBox').innerText.replace('[APA 7th]', '')); alert('APA Format Copied!');" class="w-full border border-slate-200 hover:bg-slate-50 text-slate-700 font-medium py-2 rounded-xl transition text-xs cursor-pointer">📋 Copy APA Citation</button>
        </div>

        <!-- 联盟变现位 -->
        <div class="bg-amber-50/60 border border-amber-200 p-4 rounded-xl text-xs space-y-2">
          <span class="text-amber-800 font-bold tracking-wider uppercase block text-[10px]">✨ Academic Writing Companion</span>
          <p class="text-slate-600 leading-relaxed">Writing or editing a research paper? Check grammar and technical style instantly.</p>
          <a href="https://grammarly.com" target="_blank" class="text-indigo-600 font-bold hover:underline block pt-1">Try #1 Academic Proofreader →</a>
        </div>
      </div>
    </div>
  </main>

  <footer class="bg-white border-t border-slate-200 py-6 text-center text-xs text-slate-400">
    <p>Data verified via ://academiccite.com. © {currentYear} AcademicCite.com</p>
  </footer>
</body>
</html>
