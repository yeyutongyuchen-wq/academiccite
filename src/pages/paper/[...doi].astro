---
/**
 * src/pages/paper/[...doi].astro
 * Production SSR detail page for AcademicCite
 */

export const prerender = false; // 强制 SSR

// ---------------------------------------------------------------------------
// 1. 提取并规范化 DOI
// ---------------------------------------------------------------------------
const rawParam = Astro.params.doi;

if (!rawParam || typeof rawParam !== 'string' || rawParam.trim().length === 0) {
  return Astro.redirect('/404');
}

let doi = decodeURIComponent(rawParam)
  .replace(/^https?:\/\/(dx\.)?doi\.org\//i, '')
  .replace(/^doi:/i, '')
  .trim();

if (!doi || doi.length > 512) {
  return Astro.redirect('/404');
}

// ---------------------------------------------------------------------------
// 2. 从后端 API 获取论文元数据
// ---------------------------------------------------------------------------
interface PaperData {
  doi: string;
  title: string | null;
  citations: number | null;
  abstract: string | null;
  open_access_pdf: string | null;
  publication_year?: number | null;
  source?: string;
  error?: string;
}

let paper: PaperData = {
  doi,
  title: null,
  citations: null,
  abstract: null,
  open_access_pdf: null,
  publication_year: null,
};

let fetchError: string | null = null;

try {
  // 生产环境请使用 https://api.academiccite.com
  // 本地开发可临时改为 http://127.0.0.1:3000
  const apiUrl = `https://api.academiccite.com/api/paper/${encodeURIComponent(doi)}`;
  
  const res = await fetch(apiUrl, {
    headers: {
      Accept: 'application/json',
      'User-Agent': 'AcademicCite-SSR/1.0',
    },
  });

  if (res.ok) {
    const data = await res.json();
    paper = {
      doi: data.doi || doi,
      title: data.title ?? null,
      citations: typeof data.citations === 'number' ? data.citations : null,
      abstract: data.abstract ?? null,
      open_access_pdf: data.open_access_pdf ?? null,
      publication_year: typeof data.publication_year === 'number' ? data.publication_year : null,
      source: data.source,
    };
  } else {
    fetchError = `Upstream returned HTTP ${res.status}`;
  }
} catch (err: any) {
  fetchError = err?.message || 'Network error while fetching paper metadata';
}

// ---------------------------------------------------------------------------
// 3. 爬取预算节流规则
// ---------------------------------------------------------------------------
const currentYear = new Date().getFullYear();
const year = paper.publication_year ?? null;
const citations = paper.citations ?? 0;
const hasAbstract = !!(paper.abstract && paper.abstract.trim().length > 30);

let shouldIndex = true;

if (
  citations === 0 &&
  year !== null &&
  year < currentYear - 3 &&
  !hasAbstract
) {
  shouldIndex = false;
}

// ---------------------------------------------------------------------------
// 4. 程序化生成 3 句 AI Summary（预渲染给 LLM 抓取）
// ---------------------------------------------------------------------------
function generateAiSummary(p: PaperData): string[] {
  const title = p.title || 'This scholarly work';
  const abs = (p.abstract || '').replace(/\s+/g, ' ').trim();
  const cites = p.citations ?? 0;

  const sentences: string[] = [];

  // 句子 1
  sentences.push(
    `This paper, titled “${title}”, presents original research findings relevant to its core academic domain.`
  );

  // 句子 2
  if (abs.length > 40) {
    const first = abs.split(/(?<=[.!?])\s+/)[0]?.trim() || abs.slice(0, 140);
    const cleaned = first.endsWith('.') ? first : first + '.';
    sentences.push(cleaned.length > 180 ? cleaned.slice(0, 177) + '…' : cleaned);
  } else {
    sentences.push(
      `The work addresses key questions in its field and contributes empirical or theoretical insights for researchers.`
    );
  }

  // 句子 3
  if (cites > 0) {
    sentences.push(
      `It has accumulated ${cites.toLocaleString()} citations to date, indicating sustained scholarly attention and influence.`
    );
  } else {
    sentences.push(
      `Readers can access the full text (when available) and generate standard academic citations directly from this page.`
    );
  }

  return sentences.slice(0, 3);
}

const aiSummary = generateAiSummary(paper);

// ---------------------------------------------------------------------------
// 5. JSON-LD (ScholarlyArticle)
// ---------------------------------------------------------------------------
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: paper.title || `Paper ${paper.doi}`,
  name: paper.title || `Paper ${paper.doi}`,
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'DOI',
    value: paper.doi,
  },
  sameAs: `https://doi.org/${paper.doi}`,
  url: `https://academiccite.com/paper/${encodeURIComponent(paper.doi)}`,
  description: paper.abstract || undefined,
  datePublished: paper.publication_year ? String(paper.publication_year) : undefined,
  interactionStatistic: paper.citations != null
    ? {
        '@type': 'InteractionCounter',
        interactionType: 'https://schema.org/CiteAction',
        userInteractionCount: paper.citations,
      }
    : undefined,
  isAccessibleForFree: !!paper.open_access_pdf,
};

const pageTitle = paper.title
  ? `${paper.title} | AcademicCite`
  : `DOI ${paper.doi} | AcademicCite`;

const pageDescription =
  paper.abstract?.slice(0, 160) ||
  `View metadata, abstract, citation count and open-access PDF for DOI ${paper.doi}.`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    {/* 爬取预算控制 */}
    {shouldIndex ? (
      <meta name="robots" content="index, follow, max-image-preview:large" />
    ) : (
      <meta name="robots" content="noindex, follow" />
    )}

    <link rel="canonical" href={`https://academiccite.com/paper/${encodeURIComponent(paper.doi)}`} />

    {/* ScholarlyArticle JSON-LD */}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body class="bg-slate-50 text-slate-800 antialiased min-h-screen">
    <!-- 顶部工具栏 -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30">
      <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/" class="font-semibold text-slate-900 tracking-tight">
          AcademicCite
        </a>
        <div class="flex items-center gap-3 text-sm">
          <a
            href="https://www.grammarly.com"
            target="_blank"
            rel="noopener sponsored"
            class="px-3 py-1.5 rounded-md bg-emerald-50 text-emerald-700 hover:bg-emerald-100 transition"
          >
            Grammarly
          </a>
          <a
            href="https://quillbot.com"
            target="_blank"
            rel="noopener sponsored"
            class="px-3 py-1.5 rounded-md bg-indigo-50 text-indigo-700 hover:bg-indigo-100 transition"
          >
            QuillBot
          </a>
        </div>
      </div>
    </header>

    <main class="max-w-5xl mx-auto px-4 py-8">
      {/* 广告位占位 */}
      <div class="mb-8 p-4 bg-slate-100 border border-dashed border-slate-300 rounded-lg text-center text-sm text-slate-500">
        [Display Ad Slot – 728×90 / Responsive]
      </div>

      {/* 错误提示 */}
      {fetchError && (
        <div class="mb-6 p-4 bg-amber-50 border border-amber-200 rounded-lg text-amber-800 text-sm">
          Unable to fully load metadata: {fetchError}. Showing available information.
        </div>
      )}

      {/* 主体内容 */}
      <article class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="p-6 sm:p-8">
          <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 leading-tight mb-4">
            {paper.title || `Paper ${paper.doi}`}
          </h1>

          <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-600 mb-6">
            <span class="font-medium text-slate-800">
              DOI: <a href={`https://doi.org/${paper.doi}`} class="text-blue-600 hover:underline" target="_blank" rel="noopener">{paper.doi}</a>
            </span>
            {paper.publication_year && (
              <span>Published: {paper.publication_year}</span>
            )}
            <span>
              Citations: <strong class="text-slate-900">{(paper.citations ?? 0).toLocaleString()}</strong>
            </span>
          </div>

          {/* AI Summary 拦截区块 */}
          <section id="ai-summary" class="mb-8 p-5 bg-gradient-to-br from-slate-50 to-blue-50 border border-blue-100 rounded-xl">
            <h2 class="text-sm font-semibold text-blue-800 uppercase tracking-wider mb-3">
              Key Takeaways
            </h2>
            <ul class="space-y-2.5">
              {aiSummary.map((sentence) => (
                <li class="flex gap-2.5 text-[15px] leading-relaxed text-slate-700">
                  <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-blue-500 shrink-0"></span>
                  <span>{sentence}</span>
                </li>
              ))}
            </ul>
          </section>

          {/* 摘要 */}
          {paper.abstract ? (
            <section class="mb-8">
              <h2 class="text-lg font-semibold text-slate-900 mb-3">Abstract</h2>
              <p class="text-slate-700 leading-relaxed whitespace-pre-line">
                {paper.abstract}
              </p>
            </section>
          ) : (
            <section class="mb-8 p-4 bg-slate-50 rounded-lg text-slate-500 text-sm">
              No abstract available for this record.
            </section>
          )}

          {/* 工具箱 */}
          <div class="grid sm:grid-cols-2 gap-4 p-5 bg-slate-900 text-white rounded-xl">
            <div>
              <h3 class="font-semibold mb-1">Download Free PDF</h3>
              <p class="text-sm text-slate-300 mb-3">
                Via Unpaywall / OpenAlex open-access location
              </p>
              {paper.open_access_pdf ? (
                <a
                  href={paper.open_access_pdf}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center gap-2 px-4 py-2.5 bg-emerald-500 hover:bg-emerald-400 text-white font-medium rounded-lg transition"
                >
                  Download Free PDF
                </a>
              ) : (
                <span class="inline-block px-4 py-2.5 bg-slate-700 text-slate-400 rounded-lg text-sm">
                  No open PDF detected
                </span>
              )}
            </div>

            <div>
              <h3 class="font-semibold mb-1">Generate Citation</h3>
              <p class="text-sm text-slate-300 mb-3">
                APA / MLA / Chicago formats
              </p>
              <div class="flex flex-wrap gap-2">
                <button
                  type="button"
                  class="px-3 py-2 bg-white/10 hover:bg-white/20 rounded-lg text-sm transition"
                  onclick={`navigator.clipboard.writeText('${(paper.title || '').replace(/'/g, "\\'")} (${paper.publication_year || 'n.d.'}). https://doi.org/${paper.doi}')`}
                >
                  APA
                </button>
                <button
                  type="button"
                  class="px-3 py-2 bg-white/10 hover:bg-white/20 rounded-lg text-sm transition"
                  onclick={`navigator.clipboard.writeText('"${(paper.title || '').replace(/'/g, "\\'")}." https://doi.org/${paper.doi}.')`}
                >
                  MLA
                </button>
                <a
                  href={`https://doi.org/${paper.doi}`}
                  target="_blank"
                  rel="noopener"
                  class="px-3 py-2 bg-white/10 hover:bg-white/20 rounded-lg text-sm transition"
                >
                  Cite via DOI
                </a>
              </div>
            </div>
          </div>
        </div>
      </article>

      {/* 广告位 */}
      <div class="my-10 p-6 bg-slate-100 border border-dashed border-slate-300 rounded-lg text-center text-sm text-slate-500">
        [Display Ad Slot – Rectangle / In-article]
      </div>

      {/* 联盟工具 */}
      <aside class="bg-white border border-slate-200 rounded-xl p-6 mb-10">
        <h2 class="text-base font-semibold text-slate-900 mb-3">
          Writing & Productivity Tools
        </h2>
        <div class="flex flex-wrap gap-3">
          <a
            href="https://www.grammarly.com"
            target="_blank"
            rel="noopener sponsored"
            class="inline-flex items-center gap-2 px-4 py-2.5 border border-emerald-200 bg-emerald-50 text-emerald-800 rounded-lg hover:bg-emerald-100 transition text-sm font-medium"
          >
            Improve clarity with Grammarly
          </a>
          <a
            href="https://quillbot.com"
            target="_blank"
            rel="noopener sponsored"
            class="inline-flex items-center gap-2 px-4 py-2.5 border border-indigo-200 bg-indigo-50 text-indigo-800 rounded-lg hover:bg-indigo-100 transition text-sm font-medium"
          >
            Paraphrase with QuillBot
          </a>
        </div>
      </aside>
    </main>

    <footer class="border-t border-slate-200 bg-white py-8">
      <div class="max-w-5xl mx-auto px-4 text-center text-sm text-slate-500">
        <p>© {new Date().getFullYear()} AcademicCite · Metadata powered by OpenAlex</p>
        <p class="mt-1">This page is optimized for academic search and AI retrieval systems.</p>
      </div>
    </footer>
  </body>
</html>
