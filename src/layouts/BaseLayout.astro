---
interface Props {
  title: string;
  description?: string;
  robots?: string;
  jsonLd?: Record<string, any> | null;
}

const {
  title,
  description = 'Academic Citation Cross-Reference & Research Trend Visualizer',
  robots = 'index, follow',
  jsonLd = null
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
 <!-- 如果不是真正的最终生产上线环境，一律加上 noindex -->
  {!isProd && <meta name="robots" content="content="noindex, nofollow"" />}
  
  <!-- 如果你在测试时 import.meta.env.PROD 已经是 true，你可以直接硬编码一行，测完再删： -->
  <meta name="robots" content="noindex, nofollow" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class="min-h-screen">
    <slot />
  </body>
</html>
