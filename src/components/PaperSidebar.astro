---
interface Props {
  isOa: boolean;
  pdfUrl: string | null;
  publisherUrl: string | null;
  apa: string;
  ieee: string;
  mla: string;
}
const { isOa, pdfUrl, publisherUrl, apa, ieee, mla } = Astro.props;
---

<aside class="space-y-6">
  <!-- 开放获取 / 出版商按钮 -->
  {isOa && pdfUrl ? (
    <a
      href={pdfUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-center gap-2 w-full px-5 py-3.5 rounded-xl font-semibold text-white bg-academic-emerald-600 hover:bg-academic-emerald-700 shadow-sm transition-colors"
    >
      <span>📄</span>
      <span>Read Free Legal Full-Text PDF</span>
    </a>
  ) : (
    <a
      href={publisherUrl || '#'}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-center gap-2 w-full px-5 py-3.5 rounded-xl font-semibold text-academic-slate-700 bg-academic-slate-200 hover:bg-academic-slate-300 transition-colors"
    >
      <span>View on Publisher Site</span>
    </a>
  )}

  <!-- 引用生成器 -->
  <div>
    <h3 class="text-sm font-semibold text-academic-slate-700 mb-3 uppercase tracking-wide">Cite this paper</h3>
    <CitationTabs apa={apa} ieee={ieee} mla={mla} />
  </div>

  <!-- 学术写作工具推广 -->
  <div class="rounded-xl border border-academic-indigo-100 bg-academic-indigo-50 p-5">
    <p class="text-sm font-medium text-academic-indigo-900 mb-2">
      Writing or editing a research paper?
    </p>
    <p class="text-sm text-academic-slate-700 mb-4 leading-relaxed">
      Check for structural clarity, vocabulary tone, and reference syntax with the #1 Academic Proofreader.
    </p>
    <a
      href="https://www.grammarly.com/"
      target="_blank"
      rel="noopener noreferrer sponsored"
      class="inline-flex items-center text-sm font-semibold text-academic-indigo-700 hover:text-academic-indigo-900 underline underline-offset-2"
    >
      Try Grammarly for Academic Writing →
    </a>
  </div>
</aside>

---
import CitationTabs from './CitationTabs.astro';