---
interface Props {
  doi: string;
  title: string;
}
const { doi, title } = Astro.props;
---

<nav class="text-sm text-academic-slate-500 mb-6" aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-1">
    <li><a href="/" class="hover:text-academic-indigo-600 transition-colors">Home</a></li>
    <li class="mx-1">/</li>
    <li><a href="/paper" class="hover:text-academic-indigo-600 transition-colors">Papers</a></li>
    <li class="mx-1">/</li>
    <li class="text-academic-slate-700 font-medium truncate max-w-[280px]" title={title}>{title}</li>
  </ol>
</nav>