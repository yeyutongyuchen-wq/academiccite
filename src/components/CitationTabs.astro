---
interface Props {
  apa: string;
  ieee: string;
  mla: string;
}
const { apa, ieee, mla } = Astro.props;
---

<div class="bg-white border border-academic-slate-200 rounded-xl shadow-sm overflow-hidden" id="citation-box">
  <!-- Tabs -->
  <div class="flex border-b border-academic-slate-200 bg-academic-slate-50" role="tablist">
    <button
      type="button"
      role="tab"
      data-tab="apa"
      class="citation-tab flex-1 px-4 py-3 text-sm font-medium text-academic-indigo-700 border-b-2 border-academic-indigo-600 bg-white"
      aria-selected="true"
    >
      APA 7th
    </button>
    <button
      type="button"
      role="tab"
      data-tab="ieee"
      class="citation-tab flex-1 px-4 py-3 text-sm font-medium text-academic-slate-600 border-b-2 border-transparent hover:text-academic-slate-800"
      aria-selected="false"
    >
      IEEE
    </button>
    <button
      type="button"
      role="tab"
      data-tab="mla"
      class="citation-tab flex-1 px-4 py-3 text-sm font-medium text-academic-slate-600 border-b-2 border-transparent hover:text-academic-slate-800"
      aria-selected="false"
    >
      MLA 9th
    </button>
  </div>

  <!-- Panels -->
  <div class="p-4">
    <div data-panel="apa" class="citation-panel">
      <pre class="text-sm font-mono text-academic-slate-800 whitespace-pre-wrap break-words leading-relaxed" id="apa-text">{apa}</pre>
      <button
        type="button"
        data-copy="apa"
        class="mt-3 w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-medium rounded-lg bg-academic-indigo-600 text-white hover:bg-academic-indigo-700 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
        Copy APA
      </button>
    </div>

    <div data-panel="ieee" class="citation-panel hidden">
      <pre class="text-sm font-mono text-academic-slate-800 whitespace-pre-wrap break-words leading-relaxed" id="ieee-text">{ieee}</pre>
      <button
        type="button"
        data-copy="ieee"
        class="mt-3 w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-medium rounded-lg bg-academic-indigo-600 text-white hover:bg-academic-indigo-700 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
        Copy IEEE
      </button>
    </div>

    <div data-panel="mla" class="citation-panel hidden">
      <pre class="text-sm font-mono text-academic-slate-800 whitespace-pre-wrap break-words leading-relaxed" id="mla-text">{mla}</pre>
      <button
        type="button"
        data-copy="mla"
        class="mt-3 w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-medium rounded-lg bg-academic-indigo-600 text-white hover:bg-academic-indigo-700 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
        Copy MLA
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const root = document.getElementById('citation-box');
    if (!root) return;

    const tabs = root.querySelectorAll('.citation-tab');
    const panels = root.querySelectorAll('.citation-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-tab');

        tabs.forEach(t => {
          t.classList.remove('text-academic-indigo-700', 'border-academic-indigo-600', 'bg-white');
          t.classList.add('text-academic-slate-600', 'border-transparent');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('text-academic-indigo-700', 'border-academic-indigo-600', 'bg-white');
        tab.classList.remove('text-academic-slate-600', 'border-transparent');
        tab.setAttribute('aria-selected', 'true');

        panels.forEach(p => {
          if (p.getAttribute('data-panel') === target) {
            p.classList.remove('hidden');
          } else {
            p.classList.add('hidden');
          }
        });
      });
    });

    // 一键复制
    root.querySelectorAll('[data-copy]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const format = btn.getAttribute('data-copy');
        const textEl = document.getElementById(`${format}-text`);
        if (!textEl) return;

        const text = textEl.textContent || '';
        try {
          await navigator.clipboard.writeText(text);
          const original = btn.innerHTML;
          btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Copied!';
          btn.classList.remove('bg-academic-indigo-600', 'hover:bg-academic-indigo-700');
          btn.classList.add('bg-academic-emerald-600');
          setTimeout(() => {
            btn.innerHTML = original;
            btn.classList.add('bg-academic-indigo-600', 'hover:bg-academic-indigo-700');
            btn.classList.remove('bg-academic-emerald-600');
          }, 1800);
        } catch (e) {
          console.error('Clipboard write failed', e);
        }
      });
    });
  })();
</script>